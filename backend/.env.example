# Скопируйте в .env и заполните значения.

ENV=dev
SECRET_KEY=change-me-to-a-long-random-string

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Первичный администратор (создаётся при пустой БД) ---
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=admin

# --- Claude / Anthropic (Этап 4) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Telegram-бот (Этап 3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
